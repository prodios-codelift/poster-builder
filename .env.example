# --- Vercel Sandbox auth (used by `vp run sandbox:snapshot`) ---------------
# Option A: OIDC token from a linked project (expires after ~12h, re-pull when needed):
#   vercel link && vercel env pull .env.local
VERCEL_OIDC_TOKEN=
# Option B: access token from https://vercel.com/account/tokens plus team and project ids
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# --- Snapshot script knobs (all optional) ---------------------------------
# Branch or tag to clone (default: main)
GIT_REVISION=
# Days of non-use before the snapshot expires (default: 0 = never)
SNAPSHOT_EXPIRATION_DAYS=
# vCPUs for the build sandbox, 2 GB RAM each (default: 4)
SANDBOX_VCPUS=

# --- Dev server -----------------------------------------------------------
# Comma-separated hosts (e.g. abc.vercel.run) allowed to reach `vp dev`; also
# binds 0.0.0.0 and points HMR at wss:443. Unset = local-only dev server.
# Whatever starts the server passes it in the env, like next-shadcn-starter.
DEV_ORIGINS=
